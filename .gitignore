# Source-only repository. Everything is ignored unless explicitly allowed.
/*
!/.gitignore
!/README.md
!/LICENSE
!/LICENSES/
/LICENSES/*
!/LICENSES/ISAS-1988.txt
!/requirements.txt
!/Anim_Preview.cmd
!/Music_Loop_Editor.cmd

!/nds/
/nds/*
!/nds/Makefile
!/nds/*.ps1

!/nds/source/
/nds/source/*
!/nds/source/*.c
!/nds/source/*.h

!/nds/tools/
/nds/tools/*
!/nds/tools/*.py
# Local badge generator; keep its already-generated header in the repository.
/nds/tools/pack_credits_badge.py

!/nds/tests/
/nds/tests/*
!/nds/tests/*.py
!/nds/tests/*.c
!/nds/tests/stubs/
/nds/tests/stubs/*
!/nds/tests/stubs/*.h
!/nds/tests/video_stubs/
/nds/tests/video_stubs/*
!/nds/tests/video_stubs/*.h

!/nds/config/
/nds/config/*
# Approved numerical music edit decisions; no audio or unapproved drafts.
!/nds/config/audio_edits.json

!/experiments/
/experiments/*
!/experiments/asset_lab/
/experiments/asset_lab/*
!/experiments/asset_lab/*.py

!/experiments/audio_lab/
/experiments/audio_lab/*
!/experiments/audio_lab/*.py
!/experiments/audio_lab/requirements.txt
!/experiments/audio_lab/requirements-editor.txt

!/experiments/font_lab/
/experiments/font_lab/*
!/experiments/font_lab/*.py
!/experiments/font_lab/*.c

!/experiments/story_lab/
/experiments/story_lab/*
!/experiments/story_lab/*.py

!/experiments/video_lab/
/experiments/video_lab/*
!/experiments/video_lab/*.py
!/experiments/video_lab/*.c

# Safety net for caches and generated outputs inside allowed source locations.
**/__pycache__/
**/.venv/
**/out/
**/artifacts/
**/build/
*.pyc
*.pyo
*.nds
*.sav
*.dsv
*.elf
*.o
*.obj
*.exe
*.dll
*.map
*.bin
*.zat
*.png
*.jpg
*.jpeg
*.gif
*.ico
*.wav
*.ogg
*.mp3
*.mp4
*.zip
*.bdf
*.ttf
*.otf
